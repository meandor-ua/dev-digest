node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
# NOTE: agent-runner/ does not exist in this starter checkout — a later course
# lesson (L06, "Export to CI") adds it. These negations are pre-staged.
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
.next-e2e/
# generated by Next on every dev/build; its path flips between .next and .next-e2e
next-env.d.ts
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json
